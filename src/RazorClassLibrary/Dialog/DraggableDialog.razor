@implements IAsyncDisposable

<dialog @ref="@dialogEle" popover="manual" class="@ClassValue" style="@StyleValue" aria-label="@(HeaderContent is null ? Title : null)">
    <div class="header">
        <div @ref="@headerEle" class="header-content">
            @if (HeaderContent is not null)
            {
                @HeaderContent
            }
            else
            {
                <h2 class="title">@Title</h2>
            }
        </div>
        <button type="button" class="close-button" aria-label="@CancelText" title="@CancelText"
                @onclick="@CancelAsync">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="m4.09 4.22.06-.07a.5.5 0 0 1 .63-.06l.07.06L10 9.29l5.15-5.14a.5.5 0 0 1 .63-.06l.07.06c.18.17.2.44.06.63l-.06.07L10.71 10l5.14 5.15c.18.17.2.44.06.63l-.06.07a.5.5 0 0 1-.63.06l-.07-.06L10 10.71l-5.15 5.14a.5.5 0 0 1-.63.06l-.07-.06a.5.5 0 0 1-.06-.63l.06-.07L9.29 10 4.15 4.85a.5.5 0 0 1-.06-.63l.06-.07-.06.07Z" />
            </svg>
        </button>
    </div>
    <div class="body">
        @ChildContent
    </div>
    <div class="footer">
        @if (FooterContent is not null)
        {
            @FooterContent
        }
        else
        {
            <button type="button" class="dialog-button primary" @onclick="@ConfirmAsync">@ConfirmText</button>
            <button type="button" class="dialog-button" @onclick="@CancelAsync">@CancelText</button>
        }
    </div>
</dialog>
