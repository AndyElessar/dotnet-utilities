@inherits LayoutComponentBase

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentLayoutHamburger />
        <FluentText Weight="TextWeight.Bold" Size="TextSize.Size600">dotnet-utilities</FluentText>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation">
        <NavMenu />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content" Padding="@Padding.All6">
        @Body
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Footer">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentLink Href="https://github.com/AndyElessar/dotnet-utilities" Target="LinkTarget.Blank" IconEnd="@(new Icons.Regular.Size16.ArrowExit())">
                Source on GitHub
            </FluentLink>
            <FluentSpacer />
            <FluentLink Href="https://www.fluentui-blazor.net" Target="LinkTarget.Blank" IconEnd="@(new Icons.Regular.Size16.ArrowExit())">
                Fluent UI Blazor
            </FluentLink>
        </FluentStack>
    </FluentLayoutItem>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
